# Copy to .env and fill in. Never commit .env.

# --- Required secrets -------------------------------------------------------
# Signs login tokens. At least 32 characters; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Encrypts users' LLM provider keys at rest. Changing it makes stored keys unreadable.
PROVIDER_KEY_SECRET=
# Used by docker-compose.yml for the bundled PostgreSQL.
POSTGRES_PASSWORD=

# --- Storage ----------------------------------------------------------------
# docker-compose.yml overrides these two. Without Docker the defaults are a
# SQLite file and an embedded Qdrant directory, so nothing else needs to run.
# DATABASE_URL=sqlite:///./ragforge.db
# VECTOR_STORE_URL=./data/qdrant          # or http://localhost:6333, or :memory:
# VECTOR_STORE_API_KEY=                    # only for Qdrant Cloud / secured servers

# --- Embeddings -------------------------------------------------------------
# fastembed runs locally (downloaded once from Hugging Face, ~70 MB).
# "fake" is a hashing embedder for offline development: retrieval quality is poor.
# EMBEDDING_BACKEND=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=

# --- Ingestion and chat -----------------------------------------------------
# CHUNK_WINDOW_SIZE=800
# CHUNK_OVERLAP_SIZE=100
# MAX_UPLOAD_MB=25
# RETRIEVAL_TOP_K=6
# CHAT_HISTORY_TURNS=6
# LLM_MAX_OUTPUT_TOKENS=16000
# LLM_TIMEOUT_SECONDS=120
# Self-hosted providers ("custom") may only use public addresses unless this is
# true. Set it to run against Ollama, LM Studio or vLLM on localhost, your LAN
# or another container. Users choose these URLs and the server calls them, so
# only enable it when you trust your users with access to your network.
# ALLOW_PRIVATE_PROVIDER_URLS=false

# --- HTTP -------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:3000
# ACCESS_TOKEN_TTL_MINUTES=1440
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_BURST=20
